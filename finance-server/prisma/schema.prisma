generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// 门店
// ============================================================
model Store {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users      User[]
  categories FinanceCategory[]
  records    FinanceRecord[]
}

// ============================================================
// 用户（仅 ADMIN 角色 — 老板/财务）
// ============================================================
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  status       String   @default("ACTIVE")   // ACTIVE | INACTIVE
  storeId      String?                        // null = 可查看所有门店
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store     Store?           @relation(fields: [storeId], references: [id])
  reviews   FinanceRecord[]  @relation("Reviewer")
  auditLogs AuditLog[]

  @@index([username])
}

// ============================================================
// 收支分类
// ============================================================
model FinanceCategory {
  id        String   @id @default(uuid())
  name      String
  type      String              // INCOME | EXPENSE
  icon      String?             // emoji icon for UI
  storeId   String?             // null = 所有门店共用
  sortOrder Int      @default(0)
  isSystem  Boolean  @default(false)  // 系统预设分类不可删除
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store   Store?           @relation(fields: [storeId], references: [id])
  records FinanceRecord[]

  @@index([type])
  @@index([storeId])
}

// ============================================================
// 收支记录
// ============================================================
model FinanceRecord {
  id            String    @id @default(uuid())
  type          String              // INCOME | EXPENSE
  amount        Float
  categoryId    String
  storeId       String
  date          DateTime            // 记账日期 (Beijing 00:00, stored as UTC)
  description   String?             // 摘要/说明
  paymentMethod String?             // CASH | WECHAT | ALIPAY | BANK_CARD | TRANSFER | OTHER
  status        String    @default("PENDING")  // PENDING | APPROVED | REJECTED
  reviewerId    String?             // 审核人
  reviewNote    String?             // 审核备注
  reviewedAt    DateTime?           // 审核时间
  referenceType String?             // 关联单据类型, e.g. "PURCHASE_ORDER"
  referenceId   String?             // 关联单据号
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category FinanceCategory @relation(fields: [categoryId], references: [id])
  store    Store           @relation(fields: [storeId], references: [id])
  reviewer User?           @relation("Reviewer", fields: [reviewerId], references: [id])

  @@index([storeId, date])
  @@index([type, date])
  @@index([categoryId])
  @@index([status])
  @@index([date])
}

// ============================================================
// 操作审计日志
// ============================================================
model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resourceType String?
  resourceId   String?
  details      String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}
